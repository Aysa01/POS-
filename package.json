{
  "name": "pour-local-pos",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "scripts": {
    "start": "expo start",
    "web": "node scripts/serve-web.mjs",
    "web:dev": "expo start --web --localhost --port 8082",
    "web:open": "node scripts/open-browser.mjs",
    "build:web": "expo export --platform web --output-dir dist-web",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/bootstrap.mjs --test tests/*.test.ts",
    "prebuild": "expo prebuild --platform android",
    "build:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-short-path.ps1",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "@scure/base": "1.2.6",
    "expo": "~54.0.0",
    "expo-crypto": "~15.0.0",
    "expo-document-picker": "~14.0.0",
    "expo-file-system": "~19.0.0",
    "expo-image-picker": "~17.0.0",
    "expo-print": "~15.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-sharing": "~14.0.0",
    "expo-sqlite": "~16.0.0",
    "expo-status-bar": "~3.0.0",
    "lucide-react-native": "^1.66.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.54.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "typescript": "~5.9.2"
  }
}
