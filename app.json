{
  "expo": {
    "name": "Rositrus - Local POS",
    "slug": "pour-local-pos",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "name": "Rositrus - Local POS"
    },
    "android": {
      "package": "com.pour.localpos",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a drink photo for your local menu.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "updates": {
      "enabled": false
    }
  }
}
